{
  "name": "janjahaters",
  "productName": "janjahaters",
  "version": "2.12.0",
  "description": "Call, stream e música P2P para você e seus amigos.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:ui": "node scripts/copy-vendor.mjs && esbuild renderer/app.js --bundle --format=iife --target=chrome120 --define:import.meta.url=location.href --outfile=renderer/bundle.js && esbuild renderer/room.js --bundle --minify --format=iife --target=chrome120 --outfile=renderer/room.bundle.js && esbuild renderer/rpg/table.js --bundle --minify --format=iife --target=chrome120 --outfile=renderer/rpg.bundle.js",
    "start": "npm run build:ui && electron .",
    "dist": "npm run build:ui && electron-builder --win nsis --x64 --publish never",
    "release": "npm version patch && git push --follow-tags",
    "build:mobile": "npm run build:ui && node scripts/build-mobile.mjs && npx cap sync android",
    "build:lab": "node scripts/copy-vendor.mjs && esbuild renderer/ns-lab.js --bundle --format=iife --target=chrome120 --define:import.meta.url=location.href --outfile=renderer/ns-lab.bundle.js",
    "build:sysaudio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sysaudio.ps1"
  },
  "build": {
    "appId": "app.janjahaters",
    "productName": "janjahaters",
    "files": [
      "main.js",
      "preload.js",
      "yt.js",
      "links.js",
      "preview.js",
      "activity.js",
      "renderer/index.html",
      "renderer/style.css",
      "renderer/bundle.js",
      "renderer/room.bundle.js",
      "renderer/rpg.bundle.js",
      "renderer/rpg-data.json",
      "renderer/vfx/*.png",
      "renderer/gate-worklet.js",
      "renderer/pcm-worklet.js",
      "renderer/icon.png",
      "renderer/vendor/**",
      "oauth.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "janjahaters-Setup-${version}.${ext}",
      "shortcutName": "janjahaters",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Romeu-q",
        "repo": "janjahaters-app",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "janjahaters",
        "schemes": [
          "janjahaters"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "janja-sysaudio.exe"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "three": "^0.170.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide": "^1.63.0",
    "motion": "^14.7.1",
    "trystero": "^0.26.0"
  },
  "repository": "https://github.com/Romeu-q/janjahaters-app",
  "author": "Romeu-q"
}
